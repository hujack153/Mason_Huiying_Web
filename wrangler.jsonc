// Cloudflare Workers 設定：網站由 _build/build_all3.py 產生到 dist/，只公開 dist/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mason-huiying-web",
  "compatibility_date": "2026-06-15",
  // /auth（後台密碼登入）由程式處理，其餘都是 dist/ 的靜態網頁
  "main": "cms-auth/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth", "/callback"]
  },
  // 後台登入可使用的網站（預覽網址在 *.workers.dev）；密碼與 GitHub 金鑰設為 Secret
  "vars": {
    "ALLOWED_ORIGINS": "https://huiyingmaterials.com, *.workers.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  // 每個分支的預覽環境（npx wrangler preview 需要）；可留空
  "previews": {}
}
